[Unit]
Description=Oxenfurt Postgres backup
Documentation=file:///opt/oxenfurt/current/deploy/README.md
After=postgresql.service

[Service]
Type=oneshot
User=oxenfurt
Group=oxenfurt
EnvironmentFile=/etc/oxenfurt/backend.env
ExecStart=/opt/oxenfurt/current/deploy/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oxenfurt-backup

# Keep backup writes the only thing it can do to the filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/oxenfurt/backups
