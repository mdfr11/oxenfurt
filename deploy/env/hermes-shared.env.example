# /etc/oxenfurt/hermes-shared.env — environment leaf consumed by the
# *Hermes* English agent. Contains only the bare minimum it needs to POST
# new cards into Oxenfurt. Backend secrets do NOT live here.
#
# Install:
#   sudo install -o root -g <hermes-group> -m 0640 \
#        hermes-shared.env /etc/oxenfurt/hermes-shared.env
#
# Then add it as an EnvironmentFile to hermes-english.service —
# see deploy/hermes/integration.md.

# URL of the Practice Backend. Loopback because both services share the VPS.
OXENFURT_API_URL=http://127.0.0.1:3000

# Same INGEST_TOKEN value as in /etc/oxenfurt/backend.env. If you rotate
# this, update both files in lock-step and `systemctl restart` both services.
OXENFURT_INGEST_TOKEN=COPY_FROM_BACKEND_ENV_INGEST_TOKEN
