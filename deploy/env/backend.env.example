# /etc/oxenfurt/backend.env — production secrets for oxenfurt-backend.service
#
# Install on VPS:
#   sudo install -o root -g oxenfurt -m 0640 backend.env /etc/oxenfurt/backend.env
#
# Generate secrets on the VPS:
#   openssl rand -base64 32  # → JWT_SECRET (≥32 chars after the base64)
#   openssl rand -hex 32     # → INGEST_TOKEN

# --- Telegram ---
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER

# Single-user gate. Find yours by sending /start to @userinfobot in Telegram.
OWNER_TELEGRAM_USER_ID=000000000

# --- App secrets ---
JWT_SECRET=GENERATE_BASE64_32_BYTES_HERE_REPLACE_THIS_VALUE
INGEST_TOKEN=GENERATE_HEX_32_BYTES_HERE_REPLACE_THIS_VALUE

# --- Scopes (optional) ---
# A scope is one "academy": one deck of cards, one agent, one assignment
# slot, one stats history. The Mini App shows a switcher when there is
# more than one. Format: slug:Title:emoji:accent, comma-separated.
# The FIRST entry is the default scope and owns INGEST_TOKEN above.
# Leave SCOPES unset for a single-scope install — that is the default
# behavior with exactly one 'english' scope.
#SCOPES=english:English:🇬🇧:indigo,go:Go:🐹:emerald
# One token per ADDITIONAL scope's agent (the default scope uses
# INGEST_TOKEN). A token IS the scope: an agent physically cannot write
# into another scope's deck.
#INGEST_TOKENS=go=GENERATE_ANOTHER_HEX_32_BYTES_HERE

# --- Postgres ---
# Use the password printed to /etc/oxenfurt/.pg_password by vps-setup.sh.
DATABASE_URL=postgres://oxenfurt:REPLACE_WITH_PG_PASSWORD@127.0.0.1:5432/oxenfurt

# --- Server config ---
PORT=3000
INITDATA_MAX_AGE_SECONDS=3600
JWT_TTL_SECONDS=900

# --- Modes ---
NODE_ENV=production
# Hard refusal at startup if this is true with NODE_ENV=production. Leave false.
ENABLE_DEV_AUTH=false

# --- Backup ---
# Days to keep local backups before rotation deletes (deploy/backup.sh).
BACKUP_RETENTION_DAYS=14
# Optional: rclone remote for off-site backups (e.g. r2:oxenfurt-backups).
# Leave empty to disable off-site upload. rclone must be installed + configured.
BACKUP_RCLONE_REMOTE=
