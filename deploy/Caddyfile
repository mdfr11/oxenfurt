# Oxenfurt — Caddy reverse proxy + static host
#
# 1. Replace `oxenfurt.example.com` below with your real domain.
# 2. Make sure DNS A (and AAAA, if IPv6) records resolve to this VPS.
# 3. Install: cp deploy/Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy
#
# Caddy obtains a Let's Encrypt cert automatically on first hit.

{
	# Global options. Email is used for ACME registration / expiry notices.
	email you@example.com
}

oxenfurt.example.com {
	encode zstd gzip

	log {
		output file /var/log/caddy/oxenfurt.log {
			roll_size 10mb
			roll_keep 5
		}
		format console
	}

	# --- Security headers ---
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self' data:; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org;"
		-Server
	}

	# --- Backend API ---
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# --- Static mini-app ---
	root * /opt/oxenfurt/mini-app

	# Vite-built assets are content-hash-named; cache them aggressively.
	# `handle /assets/*` is exclusive — requests that don't find a real file
	# here return a clean 404 from file_server. Critically, they do NOT fall
	# through to the SPA fallback below, which would otherwise serve index.html
	# under a `.js` URL and trigger "Failed to load module script: MIME type ''"
	# in Telegram Desktop after a redeploy that changes asset hashes.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			hide /etc/caddy/Caddyfile
		}
	}

	# SPA fallback for everything else (root, /practice, /settings, ...).
	# `no-cache` covers ALL paths that resolve to index.html, not just the
	# literal `/` and `/index.html` — Telegram Desktop's WebView pins to the
	# served HTML otherwise and never picks up redeploys.
	handle {
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server {
			hide /etc/caddy/Caddyfile
		}
	}
}
