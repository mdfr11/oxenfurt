{
  "name": "oxenfurt",
  "version": "0.0.0",
  "private": true,
  "description": "Telegram Mini App for structured English practice from live-lesson transcripts",
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rm -rf dist .turbo .cache *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
