# Telegram bot token (for initData HMAC validation)
BOT_TOKEN=

# JWT signing secret (>=32 bytes; openssl rand -base64 32)
JWT_SECRET=

# Internal token Hermes presents on POST /ingest/cards (UUID or similar; >=16 chars)
INGEST_TOKEN=

# Single-user gate: only this Telegram user ID may obtain a session.
# Find yours via @userinfobot in Telegram.
OWNER_TELEGRAM_USER_ID=

# Postgres connection (libpq URL). Used by Drizzle.
DATABASE_URL=postgres://oxenfurt:oxenfurt@127.0.0.1:5432/oxenfurt

# HTTP port the backend binds. Bound to 127.0.0.1 in systemd; fronted by nginx/Caddy.
PORT=3000

# Max age of a Telegram initData payload, seconds. Default 3600 (1 hour, Telegram default).
INITDATA_MAX_AGE_SECONDS=3600

# JWT TTL, seconds. Default 900 (15 minutes).
JWT_TTL_SECONDS=900

# 'development' | 'production' | 'test'. Defaults to 'development'.
NODE_ENV=development

# Dev-only: when 'true', exposes GET /auth/dev-token which mints a JWT for
# OWNER_TELEGRAM_USER_ID without Telegram HMAC validation. The backend
# refuses to boot if this is true and NODE_ENV=production.
ENABLE_DEV_AUTH=true

# Optional LLM provider (OpenAI-compatible /chat/completions endpoint).
# Powers AI features like semantic answer grading and Hermes question
# enrichment. Leave all three unset to disable AI features cleanly
# (endpoints return 503 llm_not_configured).
#
# Anthropic (via their OpenAI compat layer):
#   LLM_API_BASE_URL=https://api.anthropic.com/v1
#   LLM_MODEL=claude-haiku-4-5
# Moonshot / Kimi:
#   LLM_API_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=moonshot-v1-8k
# Together AI:
#   LLM_API_BASE_URL=https://api.together.xyz/v1
#   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# OpenRouter (gateway to many models):
#   LLM_API_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-haiku-4.5
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional Hermes Agent webhook — fire-and-forget HTTP POST sent whenever
# a learner attaches a question to a card. Lets the agent react in
# milliseconds instead of waiting for its next /agent/questions/pending
# poll. The body is signed via X-Webhook-Signature (HMAC-SHA256 of the
# JSON body using the secret below).
#
# Leave both blank to disable. Generate a strong secret with:
#   openssl rand -hex 32
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=
