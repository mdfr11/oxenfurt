# Telegram bot token (for initData HMAC validation)
BOT_TOKEN=

# JWT signing secret (>=32 bytes; openssl rand -base64 32)
JWT_SECRET=

# Internal token Hermes presents on POST /ingest/cards (UUID or similar; >=16 chars)
INGEST_TOKEN=

# Single-user gate: only this Telegram user ID may obtain a session.
# Find yours via @userinfobot in Telegram.
OWNER_TELEGRAM_USER_ID=

# Postgres connection (libpq URL). Used by Drizzle.
DATABASE_URL=postgres://oxenfurt:oxenfurt@127.0.0.1:5432/oxenfurt

# HTTP port the backend binds. Bound to 127.0.0.1 in systemd; fronted by nginx/Caddy.
PORT=3000

# Max age of a Telegram initData payload, seconds. Default 3600 (1 hour, Telegram default).
INITDATA_MAX_AGE_SECONDS=3600

# JWT TTL, seconds. Default 900 (15 minutes).
JWT_TTL_SECONDS=900

# 'development' | 'production' | 'test'. Defaults to 'development'.
NODE_ENV=development

# Dev-only: when 'true', exposes GET /auth/dev-token which mints a JWT for
# OWNER_TELEGRAM_USER_ID without Telegram HMAC validation. The backend
# refuses to boot if this is true and NODE_ENV=production.
ENABLE_DEV_AUTH=true
